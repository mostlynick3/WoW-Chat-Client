[Desktop Entry]
Type=Application
Name=WoW Chat Client
Comment=WotLK 3.3.5a chat client
Exec=wow-chat-desktop
Icon=WoW-Chat-Client
Categories=Game;Chat;
Terminal=false
# Must match the GTK window's WM_CLASS class, else the taskbar/dock
# shows a generic icon (verified via xprop: "wow-chat-desktop","Wow-chat-desktop").
StartupWMClass=Wow-chat-desktop
